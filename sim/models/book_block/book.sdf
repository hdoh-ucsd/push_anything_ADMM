<?xml version="1.0"?>
<!-- Block object: hand-authored box decomposition of the imported
     mesh of the same name. Single link, one <box> per piece. -->
<sdf version="1.7">
  <model name="book">
    <link name="book">
      <inertial>
        <pose>0.001000 0.000100 -0.000200 0 0 0</pose>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000151685543</ixx>
          <iyy>8.65663734e-05</iyy>
          <izz>0.000224171167</izz>
          <ixy>-2.87327877e-06</ixy>
          <ixz>1e-08</ixz>
          <iyz>1e-09</iyz>
        </inertia>
      </inertial>
      <visual name="box_0">
        <pose>0.001000 0.000100 -0.000200 0 0 -0.043900</pose>
        <geometry>
          <box><size>0.138000 0.186400 0.041100</size></box>
        </geometry>
        <material>
          <diffuse>0.75 0.75 0.75 1</diffuse>
        </material>
      </visual>
      <collision name="box_0_volume">
        <pose>0.001000 0.000100 -0.000200 0 0 -0.043900</pose>
        <geometry>
          <box><size>0.138000 0.186400 0.041100</size></box>
        </geometry>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus> 3.0e7 </drake:hydroelastic_modulus>
          <drake:mesh_resolution_hint> 0.02 </drake:mesh_resolution_hint>
          <drake:hunt_crossley_dissipation>10</drake:hunt_crossley_dissipation>
          <drake:mu_dynamic>0.3</drake:mu_dynamic>
        </drake:proximity_properties>
      </collision>
    </link>
  </model>
</sdf>
