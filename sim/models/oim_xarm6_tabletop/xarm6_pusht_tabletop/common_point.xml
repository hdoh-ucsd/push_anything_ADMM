<mujoco model="xarm6_pusht_tabletop_common_point">
  <!-- Point-robot twin of common.xml, for the `--robot point` sanity
       check on the five tabletop scenes (previously only `clutter` had
       one -- see oim/models/pusht_clutter/ for the pattern this follows).
       Same room, same physics, same tee.xml/icra_sign.xml object and
       obstacles; the only difference is what pushes. `../xarm6/xarm6.xml`
       is not included, so nothing here is the arm -- each scene's own
       "_point" file adds a 2-DOF point pusher body directly (must be
       declared after tee.xml's `block` body: oim/tasks/pusht.py reads
       qpos assuming the point pusher's scene declares the block first,
       the opposite order from the xarm6 scenes).

       `<compiler angle="degree"/>` is normally inherited from
       ../xarm6/xarm6.xml; repeated here because icra_sign.xml's obstacle
       glyphs use `euler=` in degrees and nothing else would set it for a
       scene that skips the arm include entirely. -->
  <compiler angle="degree"/>

  <option timestep="0.01" gravity="0 0 -9.81" iterations="20" ls_iterations="20" integrator="implicitfast"/>

  <default>
    <geom friction="0.5 0.005 0.0001" solref="0.004 1" solimp="0.9 0.95 0.001"/>
    <default class="goal">
      <geom conaffinity="0" contype="0" rgba="0 1 0 0.3"/>
    </default>
    <!-- The object block's horizon endpoint x^{o*}_H, drawn as a ghost of
         the pushed object -- what the robot block aims at under
         `local_goal` tracking (see oim/tasks/pusht.py). Blue, not the
         goal's green: it is the last pose of the object block's own plan,
         which oim/runtime/overlay.py already draws in blue. Fainter
         than the goal, because it moves every control step and must not
         compete with the fixed target. -->
    <default class="local_goal">
      <geom conaffinity="0" contype="0" rgba="0 0.30 0.95 0.25"/>
    </default>
    <default class="obstacle">
      <geom conaffinity="1" contype="1" rgba="0.5 0.5 0.5 1"/>
    </default>
    <default class="tabletop_obstacle">
      <geom conaffinity="1" contype="1" rgba="1.0 0.647 0.0 1"/>
    </default>
  </default>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0.3 0.0 1"/>
    <!-- Room floor at the lab table's own foot, 0.91 m below the top -- see
         common.xml's own floor comment for the contype/conaffinity split. -->
    <geom name="floor" size="0 0 .125" type="plane" pos="0 0 -0.91"
      contype="2" conaffinity="2" material="groundplane"/>
  </worldbody>
</mujoco>
