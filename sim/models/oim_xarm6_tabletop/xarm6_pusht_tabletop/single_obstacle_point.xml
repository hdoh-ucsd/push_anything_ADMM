<mujoco model="xarm6_pusht_single_obstacle_point">
  <!-- Point-robot twin of single_obstacle.xml -- see common_point.xml.
       The cube is at (0.3523, -0.1033); the pusher starts behind the block
       at (0.381, 0.423), 0.53 m away, clear. -->
  <include file="common_point.xml"/>
  <include file="tee.xml"/>

  <worldbody>
    <camera name="front" pos="1.5592 0.0000 0.6494"
      xyaxes="0.0000 1.0000 -0.0000 -0.4226 0.0000 0.9063"/>

    <geom class="tabletop_obstacle" name="obs_box" type="box" size="0.05 0.05 0.05" pos="0.35 0.0 0.05"/>

    <body name="pusher" pos="0.381 0.480 0.0298">
      <joint name="root_x" type="slide" axis="1 0 0" damping="0.05"/>
      <joint name="root_y" type="slide" axis="0 1 0" damping="0.05"/>
      <!-- solref softer than the scene default (0.004 1): the block's
           sustained push force is pinned at mu*m*g = 0.294 N by the limit
           surface and no actuator setting changes it, but first contact
           spikes far above that at the 0.6 m/s command limit. A 0.02 s
           reference time constant absorbs the spike over a few mm of
           squish at no cost in pushing speed. It also narrows a stiffness
           mismatch: MuJoCo clamps that constant to 2*timestep, so the
           planner already sees 0.1 s at planning_dt=0.05 while execution
           ran 0.004 s. -->
      <geom name="pusher" type="sphere" size="0.02" mass="1.0" rgba="1 0 0 1" solref="0.02 1"/>
      <site name="pusher" pos="0 0 0" rgba="0 0 0 0"/>
    </body>
  </worldbody>

  <actuator>
    <velocity name="x_motor" joint="root_x" ctrllimited="true" ctrlrange="-0.6 0.6" kv="100" forcerange="-60 60"/>
    <velocity name="y_motor" joint="root_y" ctrllimited="true" ctrlrange="-0.6 0.6" kv="100" forcerange="-60 60"/>
  </actuator>

  <keyframe>
    <key name="start" qpos="0.381 0.400 0 0 0 0"/>
  </keyframe>
</mujoco>
